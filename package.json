{
  "name": "astro-unhead",
  "version": "1.0.0",
  "description": "Unhead.js middleware for Astro",
  "keywords": [
    "astro-integration",
    "unhead",
    "withastro"
  ],
  "homepage": "https://github.com/Nickersoft/astro-unhead#readme",
  "bugs": {
    "url": "https://github.com/Nickersoft/astro-unhead/issues"
  },
  "license": "MIT",
  "author": "Tyler Nickerson <radxpictures@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nickersoft/astro-unhead.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./middleware": "./dist/middleware.mjs",
    "./schema-org": "./dist/schema-org.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "fix": "vp check --fix",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "unctx": "^3.0.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.3",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "peerDependencies": {
    "@unhead/schema-org": "^3.4.2",
    "astro": "^6",
    "unhead": "^3.4.2"
  },
  "peerDependenciesMeta": {
    "@unhead/schema-org": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@12.11.2"
}
